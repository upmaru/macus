#!/bin/sh

# The Macus server runs as one OS process supervised by launchd, never as a
# distributed Erlang node: no node name, EPMD or cookie listener. Whatever
# the environment says, distribution stays off, so `bin/macus remote`, `rpc`
# and `stop` are unavailable; stop the server with SIGTERM (launchd does).
# Macus.Release refuses to record a release whose env.sh lacks this line.
export RELEASE_DISTRIBUTION=none

# Everything the release creates is owner-private: the gateway access log
# and its rotated archives (STATE/logs/gateway-access.log*) are created 0600
# inside the 0700 STATE/logs directory.
umask 077
